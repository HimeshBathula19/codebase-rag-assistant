# Backend
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-long-random-string

# Persistent storage
DATA_DIR=./data
CHROMA_DIR=./data/chroma
REPOS_DIR=./data/repos

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local
# Optional OpenAI-compatible fallback if local PyTorch is blocked
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_MODEL=text-embedding-3-small

# Retrieval / RAG (defaults; overridable per request)
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
DEFAULT_TOP_K=8

# Optional default GitHub token for private repos (never returned by the API)
GITHUB_TOKEN=

# LLM (OpenAI-compatible). Leave empty to use extractive grounded mode only.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Frontend (Vite)
VITE_API_URL=http://127.0.0.1:8000
